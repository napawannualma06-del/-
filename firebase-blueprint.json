{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email"
        },
        "name": {
          "type": "string",
          "description": "User's display name"
        },
        "role": {
          "type": "string",
          "enum": ["employee", "admin"],
          "description": "Role of the user"
        },
        "fcmToken": {
          "type": "string",
          "description": "FCM device token for push notifications"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "Case": {
      "title": "Case",
      "description": "A case to be processed",
      "type": "object",
      "properties": {
        "agentName": {
          "type": "string",
          "description": "Sender"
        },
        "iphoneModel": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "credit_check", "processing", "closed", "cancelled"],
          "description": "Case lifecycle statuses: pending, credit_check, processing, closed, cancelled"
        },
        "contractNumber": {
          "type": "string",
          "description": "Contract number or agreement reference"
        },
        "contractUpdatedAt": {
          "type": "number",
          "description": "Timestamp when contract number was last updated"
        },
        "contractUpdatedBy": {
          "type": "string",
          "description": "Name of employee who entered or updated the contract number"
        },
        "remarks": {
          "type": "string",
          "description": "Note or reason why task is stuck, held, or special remarks"
        },
        "remarksUpdatedAt": {
          "type": "number",
          "description": "Timestamp when remark was last updated"
        },
        "remarksUpdatedBy": {
          "type": "string",
          "description": "Name of employee who entered or updated the remark"
        },
        "assigneeId": {
          "type": "string",
          "description": "User ID of the employee who accepted the case"
        },
        "assigneeName": {
          "type": "string"
        },
        "previousAssigneeName": {
          "type": "string",
          "description": "Name of employee who previously accepted this case before returning it"
        },
        "previousAssigneeId": {
          "type": "string",
          "description": "User ID of the employee who previously accepted this case"
        },
        "returnedBy": {
          "type": "string",
          "description": "Name of employee who performed the return action"
        },
        "returnedById": {
          "type": "string",
          "description": "User ID of employee who performed the return action"
        },
        "returnedAt": {
          "type": "number",
          "description": "Timestamp when case was returned to pending queue"
        },
        "returnedReason": {
          "type": "string",
          "description": "Reason provided when returning the case"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "completedAt": {
          "type": "number",
          "description": "Timestamp when case was closed"
        }
      },
      "required": ["agentName", "iphoneModel", "province", "status", "createdAt", "updatedAt"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Agent or sender profile",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the agent"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when agent was added"
        },
        "createdBy": {
          "type": "string",
          "description": "Name of user who added the agent"
        },
        "createdById": {
          "type": "string",
          "description": "User ID of user who added the agent"
        }
      },
      "required": ["name", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "cases/{caseId}": {
      "schema": "Case",
      "description": "Cases queue"
    },
    "agents/{agentId}": {
      "schema": "Agent",
      "description": "List of agents for selection"
    }
  }
}
