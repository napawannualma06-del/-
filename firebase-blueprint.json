{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email"
        },
        "name": {
          "type": "string",
          "description": "User's display name"
        },
        "role": {
          "type": "string",
          "enum": ["employee", "admin"],
          "description": "Role of the user"
        },
        "fcmToken": {
          "type": "string",
          "description": "FCM device token for push notifications"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "Case": {
      "title": "Case",
      "description": "A case to be processed",
      "type": "object",
      "properties": {
        "agentName": {
          "type": "string",
          "description": "Sender"
        },
        "iphoneModel": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "credit_check", "processing", "closed", "cancelled"],
          "description": "Case lifecycle statuses: pending, credit_check, processing, closed, cancelled"
        },
        "contractNumber": {
          "type": "string",
          "description": "Contract number or agreement reference"
        },
        "contractUpdatedAt": {
          "type": "number",
          "description": "Timestamp when contract number was last updated"
        },
        "contractUpdatedBy": {
          "type": "string",
          "description": "Name of employee who entered or updated the contract number"
        },
        "remarks": {
          "type": "string",
          "description": "Note or reason why task is stuck, held, or special remarks"
        },
        "remarksUpdatedAt": {
          "type": "number",
          "description": "Timestamp when remark was last updated"
        },
        "remarksUpdatedBy": {
          "type": "string",
          "description": "Name of employee who entered or updated the remark"
        },
        "assigneeId": {
          "type": "string",
          "description": "User ID of the employee who accepted the case"
        },
        "assigneeName": {
          "type": "string"
        },
        "previousAssigneeName": {
          "type": "string",
          "description": "Name of employee who previously accepted this case before returning it"
        },
        "previousAssigneeId": {
          "type": "string",
          "description": "User ID of the employee who previously accepted this case"
        },
        "returnedBy": {
          "type": "string",
          "description": "Name of employee who performed the return action"
        },
        "returnedById": {
          "type": "string",
          "description": "User ID of employee who performed the return action"
        },
        "returnedAt": {
          "type": "number",
          "description": "Timestamp when case was returned to pending queue"
        },
        "returnedReason": {
          "type": "string",
          "description": "Reason provided when returning the case"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        },
        "completedAt": {
          "type": "number",
          "description": "Timestamp when case was closed"
        },
        "cancelledAt": {
          "type": "number",
          "description": "Timestamp when case was cancelled"
        },
        "cancelledBy": {
          "type": "string",
          "description": "Name or system identifier of who cancelled the case"
        },
        "isStuck": {
          "type": "boolean",
          "description": "Whether case is marked as stuck/held"
        },
        "stuckAt": {
          "type": "number",
          "description": "Timestamp when case was marked stuck"
        },
        "stuckBy": {
          "type": "string",
          "description": "Name of user who marked case as stuck"
        },
        "stuckReason": {
          "type": "string",
          "description": "Required reason note why case is stuck"
        }
      },
      "required": ["agentName", "iphoneModel", "province", "status", "createdAt", "updatedAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Real-time action log of what team members did",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of action performed"
        },
        "actorId": {
          "type": "string",
          "description": "User ID of actor"
        },
        "actorName": {
          "type": "string",
          "description": "Display name of actor"
        },
        "actorAvatarEmoji": {
          "type": "string",
          "description": "Emoji avatar of actor"
        },
        "description": {
          "type": "string",
          "description": "Description of action"
        },
        "caseId": {
          "type": "string",
          "description": "Associated case ID"
        },
        "iphoneModel": {
          "type": "string",
          "description": "Associated iPhone model"
        },
        "timestamp": {
          "type": "number",
          "description": "Timestamp of action"
        }
      },
      "required": ["type", "actorId", "actorName", "description", "timestamp"]
    },
    "TeamChat": {
      "title": "TeamChat",
      "description": "Real-time team chat messages with mention support",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "User ID of sender"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of sender"
        },
        "senderUsername": {
          "type": "string",
          "description": "Username of sender"
        },
        "senderRole": {
          "type": "string",
          "description": "Role of sender"
        },
        "senderAvatarEmoji": {
          "type": "string",
          "description": "Emoji avatar of sender"
        },
        "text": {
          "type": "string",
          "description": "Message content"
        },
        "mentions": {
          "type": "array",
          "description": "List of tagged usernames"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of message"
        }
      },
      "required": ["senderId", "senderName", "text", "createdAt"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Agent or sender profile",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the agent"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when agent was added"
        },
        "createdBy": {
          "type": "string",
          "description": "Name of user who added the agent"
        },
        "createdById": {
          "type": "string",
          "description": "User ID of user who added the agent"
        }
      },
      "required": ["name", "createdAt"]
    },
    "OvertimeRequest": {
      "title": "OvertimeRequest",
      "description": "Employee overtime request for approval",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "Employee user ID"
        },
        "employeeName": {
          "type": "string",
          "description": "Employee display name"
        },
        "employeeUsername": {
          "type": "string",
          "description": "Employee username"
        },
        "employeeAvatarEmoji": {
          "type": "string",
          "description": "Employee avatar emoji"
        },
        "date": {
          "type": "string",
          "description": "OT Date in YYYY-MM-DD format"
        },
        "startTime": {
          "type": "string",
          "description": "Start time in HH:mm"
        },
        "endTime": {
          "type": "string",
          "description": "End time in HH:mm"
        },
        "hours": {
          "type": "number",
          "description": "Calculated or entered total OT hours"
        },
        "reason": {
          "type": "string",
          "description": "Reason for working overtime"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status"
        },
        "approvedBy": {
          "type": "string",
          "description": "Name of admin who approved or rejected"
        },
        "approvedById": {
          "type": "string",
          "description": "ID of admin who reviewed"
        },
        "reviewedAt": {
          "type": "number",
          "description": "Timestamp when review occurred"
        },
        "adminComment": {
          "type": "string",
          "description": "Admin review note"
        },
        "cyclePeriod": {
          "type": "string",
          "description": "Payroll billing cycle (e.g. 2026-09: 26 Aug - 25 Sep)"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["employeeId", "employeeName", "date", "startTime", "endTime", "hours", "reason", "status", "cyclePeriod", "createdAt", "updatedAt"]
    },
    "AdvanceRequest": {
      "title": "AdvanceRequest",
      "description": "Employee salary advance request with slip attachment support",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "Employee user ID"
        },
        "employeeName": {
          "type": "string",
          "description": "Employee display name"
        },
        "employeeUsername": {
          "type": "string",
          "description": "Employee username"
        },
        "employeeAvatarEmoji": {
          "type": "string",
          "description": "Employee avatar emoji"
        },
        "amount": {
          "type": "number",
          "description": "Requested advance amount in THB"
        },
        "requestDate": {
          "type": "string",
          "description": "Date of request in YYYY-MM-DD format"
        },
        "reason": {
          "type": "string",
          "description": "Reason or purpose for advance request"
        },
        "bankName": {
          "type": "string",
          "description": "Destination bank name"
        },
        "accountNumber": {
          "type": "string",
          "description": "Bank account number"
        },
        "accountName": {
          "type": "string",
          "description": "Bank account owner name"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Advance approval status"
        },
        "cyclePeriod": {
          "type": "string",
          "description": "Payroll billing cycle cutoff 25 (e.g. 2026-09: 26 Aug - 25 Sep)"
        },
        "slipUrl": {
          "type": "string",
          "description": "Transfer slip image URL or base64 data"
        },
        "slipFileName": {
          "type": "string",
          "description": "Filename of attached slip"
        },
        "slipUploadedAt": {
          "type": "number",
          "description": "Timestamp when slip was attached"
        },
        "slipUploadedBy": {
          "type": "string",
          "description": "Name of user who attached the slip"
        },
        "approvedBy": {
          "type": "string",
          "description": "Name of admin who reviewed"
        },
        "approvedById": {
          "type": "string",
          "description": "User ID of admin who reviewed"
        },
        "reviewedAt": {
          "type": "number",
          "description": "Timestamp when reviewed"
        },
        "adminComment": {
          "type": "string",
          "description": "Admin review note"
        },
        "createdAt": {
          "type": "number"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["employeeId", "employeeName", "amount", "requestDate", "reason", "status", "cyclePeriod", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "cases/{caseId}": {
      "schema": "Case",
      "description": "Cases queue"
    },
    "agents/{agentId}": {
      "schema": "Agent",
      "description": "List of agents for selection"
    },
    "activities/{activityId}": {
      "schema": "Activity",
      "description": "Real-time activity audit feed"
    },
    "team_chats/{messageId}": {
      "schema": "TeamChat",
      "description": "Real-time team chat messages"
    },
    "overtime_requests/{requestId}": {
      "schema": "OvertimeRequest",
      "description": "Employee overtime requests"
    },
    "advance_requests/{requestId}": {
      "schema": "AdvanceRequest",
      "description": "Employee advance payment requests with slip support"
    }
  }
}

