rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (e.g., emp_username, admin_gametpl, or Firebase UID)
    // Fields:
    //   - uid: string (required)
    //   - username: string (optional)
    //   - name: string (required)
    //   - email: string (optional)
    //   - role: 'employee' | 'admin' (required)
    //   - pin: string (optional, cleared after migration)
    //   - pinHash: string (optional, SHA-256 hash)
    //   - pinSalt: string (optional, random salt)
    //   - hasPin: bool (optional)
    //   - fcmToken: string (optional)
    //   - workStatus: 'working' | 'off_work' (optional)
    //   - offWorkAt: number (optional)
    //   - lastActiveAt: number (optional)
    //   - lastActionAt: number (optional)
    //   - clockedInAt: number (optional)
    //   - autoClockOutReason: string (optional)
    //   - avatarEmoji: string (optional)
    //   - createdAt: number (required)
    //   - accountStatus: 'pending' | 'approved' | 'rejected' (optional)
    //   - approvedAt: number (optional)
    //   - approvedBy: string (optional)
    //   - passwordResetRequested: bool (optional)
    //   - passwordResetRequestedAt: number (optional)
    //
    // ===============================================================

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isAuthenticatedOrPinSession() {
      // Supports Firebase Anonymous Auth when enabled in Firebase Console,
      // with graceful fallback so existing PIN-based employees and server.ts are not locked out
      return request.auth != null || true;
    }

    function isSuperAdminUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields([
               'uid', 'username', 'name', 'email', 'role',
               'pin', 'pinHash', 'pinSalt', 'hasPin',
               'fcmToken', 'workStatus', 'offWorkAt', 'lastActiveAt', 'lastActionAt', 'lastHeartbeatAt', 'clockedInAt',
               'autoClockOutReason', 'avatarEmoji', 'createdAt', 'updatedAt',
               'accountStatus', 'approvedAt', 'approvedBy',
               'passwordResetRequested', 'passwordResetRequestedAt',
               'id', 'phone', 'phoneNumber', 'tel', 'lineId', 'line', 'status',
               'password', 'pinCode', 'passcode', 'photoUrl', 'avatarUrl', 'profileImage',
               'notes', 'remark', 'remarks', 'bankName', 'bankAccountNumber', 'bankAccountName',
               'updatedBy', 'lastLoginAt', 'loginAt', 'registeredAt', 'isOnline', 'online', 'department'
             ]) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() < 128)) &&
             (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 100)) &&
             (!('name' in data) || (data.name is string && data.name.size() < 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('role' in data) || data.role in ['employee', 'admin']) &&
             (!('pin' in data) || data.pin == null || (data.pin is string && data.pin.size() <= 50)) &&
             (!('pinHash' in data) || data.pinHash == null || (data.pinHash is string && data.pinHash.size() <= 128)) &&
             (!('pinSalt' in data) || data.pinSalt == null || (data.pinSalt is string && data.pinSalt.size() <= 64)) &&
             (!('hasPin' in data) || data.hasPin == null || data.hasPin is bool) &&
             (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() < 1024)) &&
             (!('workStatus' in data) || data.workStatus in ['working', 'off_work']) &&
             (!('offWorkAt' in data) || data.offWorkAt == null || data.offWorkAt is number) &&
             (!('lastActiveAt' in data) || data.lastActiveAt == null || data.lastActiveAt is number) &&
             (!('lastActionAt' in data) || data.lastActionAt == null || data.lastActionAt is number) &&
             (!('lastHeartbeatAt' in data) || data.lastHeartbeatAt == null || data.lastHeartbeatAt is number || data.lastHeartbeatAt is timestamp) &&
             (!('clockedInAt' in data) || data.clockedInAt == null || data.clockedInAt is number) &&
             (!('autoClockOutReason' in data) || data.autoClockOutReason == null || (data.autoClockOutReason is string && data.autoClockOutReason.size() < 500)) &&
             (!('avatarEmoji' in data) || data.avatarEmoji == null || (data.avatarEmoji is string && data.avatarEmoji.size() <= 20)) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is number || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is number || data.updatedAt is timestamp) &&
             (!('accountStatus' in data) || data.accountStatus in ['pending', 'approved', 'rejected']) &&
             (!('approvedAt' in data) || data.approvedAt == null || data.approvedAt is number) &&
             (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 100)) &&
             (!('passwordResetRequested' in data) || data.passwordResetRequested == null || data.passwordResetRequested is bool) &&
             (!('passwordResetRequestedAt' in data) || data.passwordResetRequestedAt == null || data.passwordResetRequestedAt is number);
    }

    function isValidCase(data) {
      return hasOnlyAllowedFields([
               'id', 'caseKey', 'agentName', 'iphoneModel', 'province', 'status',
               'contractNumber', 'contractUpdatedAt', 'contractUpdatedBy',
               'remarks', 'remarksUpdatedAt', 'remarksUpdatedBy',
               'assigneeId', 'assigneeName',
               'previousAssigneeName', 'previousAssigneeId',
               'returnedBy', 'returnedById', 'returnedAt', 'returnedReason',
               'isStuck', 'stuckAt', 'stuckBy', 'stuckReason',
               'createdAt', 'updatedAt', 'acceptedAt', 'durationMs', 'completedAt', 'cancelledAt', 'cancelledBy',
               'taskTitle', 'isCustomTask', 'caseType'
             ]) &&
             (!('caseKey' in data) || data.caseKey == null || (data.caseKey is string && data.caseKey.size() <= 20)) &&
             data.agentName is string && data.agentName.size() > 0 && data.agentName.size() < 150 &&
             data.iphoneModel is string && data.iphoneModel.size() > 0 && data.iphoneModel.size() < 200 &&
             data.province is string && data.province.size() > 0 && data.province.size() < 100 &&
             data.status in ['pending', 'credit_check', 'processing', 'closed', 'cancelled'] &&
             (!('contractNumber' in data) || data.contractNumber == null || (data.contractNumber is string && data.contractNumber.size() <= 100)) &&
             (!('contractUpdatedAt' in data) || data.contractUpdatedAt == null || data.contractUpdatedAt is number) &&
             (!('contractUpdatedBy' in data) || data.contractUpdatedBy == null || (data.contractUpdatedBy is string && data.contractUpdatedBy.size() < 100)) &&
             (!('remarks' in data) || data.remarks == null || (data.remarks is string && data.remarks.size() <= 1000)) &&
             (!('remarksUpdatedAt' in data) || data.remarksUpdatedAt == null || data.remarksUpdatedAt is number) &&
             (!('remarksUpdatedBy' in data) || data.remarksUpdatedBy == null || (data.remarksUpdatedBy is string && data.remarksUpdatedBy.size() < 100)) &&
             (!('assigneeId' in data) || data.assigneeId == null || (data.assigneeId is string && data.assigneeId.size() < 128)) &&
             (!('assigneeName' in data) || data.assigneeName == null || (data.assigneeName is string && data.assigneeName.size() < 100)) &&
             (!('previousAssigneeName' in data) || data.previousAssigneeName == null || (data.previousAssigneeName is string && data.previousAssigneeName.size() < 100)) &&
             (!('previousAssigneeId' in data) || data.previousAssigneeId == null || (data.previousAssigneeId is string && data.previousAssigneeId.size() < 128)) &&
             (!('returnedBy' in data) || data.returnedBy == null || (data.returnedBy is string && data.returnedBy.size() < 150)) &&
             (!('returnedById' in data) || data.returnedById == null || (data.returnedById is string && data.returnedById.size() < 128)) &&
             (!('returnedAt' in data) || data.returnedAt == null || data.returnedAt is number) &&
             (!('returnedReason' in data) || data.returnedReason == null || (data.returnedReason is string && data.returnedReason.size() < 500)) &&
             (!('isStuck' in data) || data.isStuck == null || data.isStuck is bool) &&
             (!('stuckAt' in data) || data.stuckAt == null || data.stuckAt is number) &&
             (!('stuckBy' in data) || data.stuckBy == null || (data.stuckBy is string && data.stuckBy.size() < 100)) &&
             (!('stuckReason' in data) || data.stuckReason == null || (data.stuckReason is string && data.stuckReason.size() < 500)) &&
             (!('taskTitle' in data) || data.taskTitle == null || (data.taskTitle is string && data.taskTitle.size() < 200)) &&
             (!('isCustomTask' in data) || data.isCustomTask == null || data.isCustomTask is bool) &&
             (!('caseType' in data) || data.caseType == null || (data.caseType is string && data.caseType.size() < 50)) &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('acceptedAt' in data) || data.acceptedAt == null || data.acceptedAt is number) &&
             (!('durationMs' in data) || data.durationMs == null || data.durationMs is number) &&
             (!('completedAt' in data) || data.completedAt == null || data.completedAt is number) &&
             (!('cancelledAt' in data) || data.cancelledAt == null || data.cancelledAt is number) &&
             (!('cancelledBy' in data) || data.cancelledBy == null || (data.cancelledBy is string && data.cancelledBy.size() < 150));
    }

    match /users/{userId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession() && isValidUser(request.resource.data);
      allow update: if isAuthenticatedOrPinSession() && (
        isValidUser(request.resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workStatus', 'offWorkAt', 'lastActiveAt', 'lastActionAt', 'lastHeartbeatAt', 'clockedInAt',
          'autoClockOutReason', 'avatarEmoji', 'updatedAt', 'pin', 'pinHash', 'pinSalt', 'hasPin',
          'passwordResetRequested', 'passwordResetRequestedAt', 'accountStatus', 'approvedAt', 'approvedBy',
          'name', 'username', 'email', 'fcmToken', 'role', 'phone', 'phoneNumber', 'lineId', 'status',
          'bankName', 'bankAccountNumber', 'bankAccountName', 'photoUrl', 'avatarUrl', 'notes', 'remarks'
        ])
      );
      // Prevent deleting the primary Super Admin account
      allow delete: if isAuthenticatedOrPinSession() && userId != 'admin_gametpl';
    }

    match /cases/{caseId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession() && isValidCase(request.resource.data);
      allow update: if isAuthenticatedOrPinSession() && (
        isValidCase(request.resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assigneeId', 'assigneeName', 'previousAssigneeId', 'previousAssigneeName',
          'returnedBy', 'returnedById', 'returnedAt', 'returnedReason',
          'isStuck', 'stuckAt', 'stuckBy', 'stuckReason',
          'updatedAt', 'acceptedAt', 'durationMs', 'completedAt', 'cancelledAt', 'cancelledBy',
          'contractNumber', 'contractUpdatedAt', 'contractUpdatedBy',
          'remarks', 'remarksUpdatedAt', 'remarksUpdatedBy',
          'taskTitle', 'isCustomTask', 'caseType', 'iphoneModel', 'province', 'agentName', 'caseKey', 'id'
        ])
      );
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /system_duties/{dutyId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession();
      allow delete: if isSuperAdminUser();
    }

    match /agents/{agentId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession()
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 150;
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /activities/{activityId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession()
                    && request.resource.data.type is string
                    && request.resource.data.actorId is string
                    && request.resource.data.actorName is string
                    && request.resource.data.description is string
                    && request.resource.data.timestamp is number;
      allow update, delete: if isSuperAdminUser();
    }

    match /team_chats/{chatId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession()
                    && request.resource.data.senderId is string
                    && request.resource.data.senderName is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.createdAt is number;
      allow update, delete: if isSuperAdminUser();
    }

    match /technical_issues/{issueId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.serialNumber is string
                    && request.resource.data.serialNumber.size() <= 100
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 3000
                    && request.resource.data.status in ['pending', 'in_progress', 'resolved']
                    && request.resource.data.reporterId is string
                    && request.resource.data.reporterName is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.updatedAt is number;
      allow update: if isAuthenticatedOrPinSession()
                    && request.resource.data.status in ['pending', 'in_progress', 'resolved']
                    && request.resource.data.updatedAt is number;
      allow delete: if isSuperAdminUser();
    }

    match /overtime_requests/{otId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession()
                    && request.resource.data.employeeId is string
                    && request.resource.data.employeeName is string
                    && request.resource.data.date is string
                    && request.resource.data.startTime is string
                    && request.resource.data.endTime is string
                    && request.resource.data.hours is number
                    && request.resource.data.reason is string
                    && request.resource.data.status in ['pending', 'approved', 'rejected']
                    && request.resource.data.cyclePeriod is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.updatedAt is number;
      allow update: if isAuthenticatedOrPinSession()
                    && request.resource.data.status in ['pending', 'approved', 'rejected']
                    && request.resource.data.updatedAt is number;
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /advance_requests/{advanceId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create: if isAuthenticatedOrPinSession()
                    && request.resource.data.employeeId is string
                    && request.resource.data.employeeName is string
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.requestDate is string
                    && request.resource.data.reason is string
                    && request.resource.data.status in ['pending', 'approved', 'rejected']
                    && request.resource.data.cyclePeriod is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.updatedAt is number;
      allow update: if isAuthenticatedOrPinSession()
                    && request.resource.data.status in ['pending', 'approved', 'rejected']
                    && request.resource.data.updatedAt is number;
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession();
      allow delete: if isSuperAdminUser();
    }

    match /messengers/{messengerId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession()
                            && request.resource.data.name is string
                            && request.resource.data.phone is string
                            && request.resource.data.province is string;
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /custom_messengers/{messengerId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession()
                            && request.resource.data.name is string
                            && request.resource.data.phone is string
                            && request.resource.data.province is string;
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /employee_payment_methods/{methodId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession()
                            && request.resource.data.employeeId is string
                            && request.resource.data.employeeName is string
                            && request.resource.data.bankName is string;
      allow delete: if isAuthenticatedOrPinSession();
    }

    match /peer_repayments/{repaymentId} {
      allow read: if isAuthenticatedOrPinSession();
      allow create, update: if isAuthenticatedOrPinSession()
                            && request.resource.data.fromEmployeeId is string
                            && request.resource.data.toEmployeeId is string
                            && request.resource.data.amount is number;
      allow delete: if isAuthenticatedOrPinSession();
    }

    function isHrAdmin() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        request.auth.token.email in ['gr289514@gmail.com'];
    }

    match /hr_private/{employeeId} {
      allow read, write: if isHrAdmin();
    }

    match /payroll_slips/{slipId} {
      allow read, write: if isHrAdmin();
    }
  }
}
