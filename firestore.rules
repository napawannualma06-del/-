rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.name is string && data.name.size() <= 128 &&
             data.role in ['employee', 'admin'];
    }

    function isValidCase(data) {
      return data.agentName is string && data.agentName.size() <= 128 &&
             data.iphoneModel is string && data.iphoneModel.size() <= 128 &&
             data.province is string && data.province.size() <= 128 &&
             data.status in ['pending', 'credit_check', 'processing', 'closed', 'cancelled'] &&
             (!('contractNumber' in data) || (data.contractNumber is string && data.contractNumber.size() <= 128)) &&
             (!('contractUpdatedBy' in data) || (data.contractUpdatedBy is string && data.contractUpdatedBy.size() <= 128)) &&
             (!('contractUpdatedAt' in data) || (data.contractUpdatedAt is number)) &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 1000)) &&
             (!('remarksUpdatedBy' in data) || (data.remarksUpdatedBy is string && data.remarksUpdatedBy.size() <= 128)) &&
             (!('remarksUpdatedAt' in data) || (data.remarksUpdatedAt is number));
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(incoming());
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if true;
      allow create, update: if isValidCase(incoming());
      allow delete: if true;
    }
  }
}
