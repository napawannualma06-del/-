rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.name is string && data.name.size() <= 128 &&
             data.role in ['employee', 'admin'] &&
             (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 64));
    }

    function isValidCase(data) {
      return data.agentName is string && data.agentName.size() <= 128 &&
             data.iphoneModel is string && data.iphoneModel.size() <= 128 &&
             data.province is string && data.province.size() <= 128 &&
             data.status in ['pending', 'credit_check', 'processing', 'closed', 'cancelled'] &&
             (!('cancelledAt' in data) || (data.cancelledAt is number)) &&
             (!('cancelledBy' in data) || (data.cancelledBy is string && data.cancelledBy.size() <= 128)) &&
             (!('contractNumber' in data) || (data.contractNumber is string && data.contractNumber.size() <= 128)) &&
             (!('contractUpdatedBy' in data) || (data.contractUpdatedBy is string && data.contractUpdatedBy.size() <= 128)) &&
             (!('contractUpdatedAt' in data) || (data.contractUpdatedAt is number)) &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 5000)) &&
             (!('remarksUpdatedBy' in data) || (data.remarksUpdatedBy is string && data.remarksUpdatedBy.size() <= 128)) &&
             (!('remarksUpdatedAt' in data) || (data.remarksUpdatedAt is number)) &&
             (!('previousAssigneeName' in data) || (data.previousAssigneeName is string && data.previousAssigneeName.size() <= 128)) &&
             (!('previousAssigneeId' in data) || (data.previousAssigneeId is string && data.previousAssigneeId.size() <= 128)) &&
             (!('returnedBy' in data) || (data.returnedBy is string && data.returnedBy.size() <= 128)) &&
             (!('returnedById' in data) || (data.returnedById is string && data.returnedById.size() <= 128)) &&
             (!('returnedAt' in data) || (data.returnedAt is number)) &&
             (!('returnedReason' in data) || (data.returnedReason is string && data.returnedReason.size() <= 500)) &&
             (!('isStuck' in data) || (data.isStuck is bool)) &&
             (!('stuckAt' in data) || (data.stuckAt is number)) &&
             (!('stuckBy' in data) || (data.stuckBy is string && data.stuckBy.size() <= 128)) &&
             (!('stuckReason' in data) || (data.stuckReason is string && data.stuckReason.size() <= 5000));
    }

    function isValidAgent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.createdAt is number &&
             (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
             (!('createdById' in data) || (data.createdById is string && data.createdById.size() <= 128));
    }

    function isValidDuty(data) {
      return (!('workers' in data) || data.workers is list) &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidActivity(data) {
      return data.type is string && data.type.size() <= 64 &&
             data.actorId is string && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() <= 128 &&
             data.description is string && data.description.size() <= 1000 &&
             data.timestamp is number &&
             (!('actorAvatarEmoji' in data) || data.actorAvatarEmoji == null || (data.actorAvatarEmoji is string && data.actorAvatarEmoji.size() <= 64)) &&
             (!('caseId' in data) || data.caseId == null || (data.caseId is string && data.caseId.size() <= 128)) &&
             (!('iphoneModel' in data) || data.iphoneModel == null || (data.iphoneModel is string && data.iphoneModel.size() <= 128));
    }

    function isValidTeamChat(data) {
      return data.senderId is string && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 128 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt is number &&
             (!('senderUsername' in data) || data.senderUsername == null || (data.senderUsername is string && data.senderUsername.size() <= 128)) &&
             (!('senderRole' in data) || data.senderRole == null || (data.senderRole is string && data.senderRole.size() <= 64)) &&
             (!('senderAvatarEmoji' in data) || data.senderAvatarEmoji == null || (data.senderAvatarEmoji is string && data.senderAvatarEmoji.size() <= 64)) &&
             (!('mentions' in data) || data.mentions == null || (data.mentions is list && data.mentions.size() <= 20));
    }

    function isValidTechnicalIssue(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.serialNumber is string && data.serialNumber.size() <= 150 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 10000 &&
             data.status in ['pending', 'in_progress', 'resolved'] &&
             data.reporterId is string && data.reporterId.size() <= 128 &&
             data.reporterName is string && data.reporterName.size() <= 128 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('reporterUsername' in data) || data.reporterUsername == null || (data.reporterUsername is string && data.reporterUsername.size() <= 128)) &&
             (!('reporterAvatarEmoji' in data) || data.reporterAvatarEmoji == null || (data.reporterAvatarEmoji is string && data.reporterAvatarEmoji.size() <= 64)) &&
             (!('adminNote' in data) || data.adminNote == null || (data.adminNote is string && data.adminNote.size() <= 5000)) &&
             (!('statusChangedBy' in data) || data.statusChangedBy == null || (data.statusChangedBy is string && data.statusChangedBy.size() <= 128)) &&
             (!('resolvedBy' in data) || data.resolvedBy == null || (data.resolvedBy is string && data.resolvedBy.size() <= 128)) &&
             (!('resolvedAt' in data) || data.resolvedAt == null || (data.resolvedAt is number));
    }

    function isValidOvertimeRequest(data) {
      return data.employeeId is string && data.employeeId.size() <= 128 &&
             data.employeeName is string && data.employeeName.size() <= 128 &&
             data.date is string && data.date.size() <= 20 &&
             data.startTime is string && data.startTime.size() <= 10 &&
             data.endTime is string && data.endTime.size() <= 10 &&
             (data.hours is number || data.hours is int) && data.hours > 0 && data.hours <= 24 &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 2000 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.cyclePeriod is string && data.cyclePeriod.size() <= 64 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('employeeUsername' in data) || data.employeeUsername == null || (data.employeeUsername is string && data.employeeUsername.size() <= 128)) &&
             (!('employeeAvatarEmoji' in data) || data.employeeAvatarEmoji == null || (data.employeeAvatarEmoji is string && data.employeeAvatarEmoji.size() <= 64)) &&
             (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 128)) &&
             (!('approvedById' in data) || data.approvedById == null || (data.approvedById is string && data.approvedById.size() <= 128)) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || (data.reviewedAt is number)) &&
             (!('adminComment' in data) || data.adminComment == null || (data.adminComment is string && data.adminComment.size() <= 1000));
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(incoming());
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow read: if true;
      allow create, update: if isValidCase(incoming());
      allow delete: if true;
    }

    match /agents/{agentId} {
      allow read: if true;
      allow create, update: if isValidAgent(incoming());
      allow delete: if true;
    }

    match /system_duties/{dutyId} {
      allow read: if true;
      allow create, update: if isValidDuty(incoming());
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create: if isValidActivity(incoming());
      allow update, delete: if false;
    }

    match /team_chats/{messageId} {
      allow read: if true;
      allow create: if isValidTeamChat(incoming());
      allow update, delete: if false;
    }

    match /technical_issues/{issueId} {
      allow read: if true;
      allow create, update: if isValidTechnicalIssue(incoming());
      allow delete: if true;
    }

    match /overtime_requests/{requestId} {
      allow read: if true;
      allow create, update: if isValidOvertimeRequest(incoming());
      allow delete: if true;
    }
  }
}
